FROM golang:1.25-bookworm AS base

ENV TZ=Asia/Jakarta

# Ensure IPv4 precedence to avoid "network is unreachable" on environments without IPv6 routing
RUN sed -i 's/^#precedence ::ffff:0:0\/96  100/precedence ::ffff:0:0\/96  100/' /etc/gai.conf 2>/dev/null || echo "precedence ::ffff:0:0/96 100" >> /etc/gai.conf

ENV GOPROXY=https://proxy.golang.org,https://goproxy.io,direct

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Build server binary into /tmp/build (not /app to avoid volume mount conflict).
RUN CGO_ENABLED=0 GOOS=linux go build -o /tmp/build/api ./cmd/api

# Install Air for hot reload (used via `docker compose run backend air`).
# Note: Air has known crashes with certain Go interface types, so the default
# CMD runs the pre-compiled binary instead.
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    GOTOOLCHAIN=auto go install github.com/air-verse/air@latest

COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 8080

# Entrypoint copies the pre-built binary into the working directory so it
# survives the bind mount at /app. Then exec runs the binary.
ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["/tmp/build/api"]
