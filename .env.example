# Social Finance Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

APP_ENV=development

# HTTP server
HTTP_PORT=8080

# PostgreSQL (use Docker service hostname "postgres" inside containers)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=social_finance
DB_USER=social_finance
DB_PASSWORD=CHANGE_ME
DB_SSLMODE=prefer

# JWT (Phase 2)
JWT_SECRET=CHANGE_ME_MIN_32_CHAR_RANDOM_STRING
JWT_EXPIRY=900
REFRESH_EXPIRY=604800

# Logging
LOG_LEVEL=info
