# Social Finance Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

APP_ENV=development

# HTTP server
HTTP_PORT=8080

# PostgreSQL (use Docker service hostname "postgres" inside containers)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=social_finance
DB_USER=social_finance
DB_PASSWORD=CHANGE_ME
DB_SSLMODE=prefer

# JWT (Phase 2)
JWT_SECRET=CHANGE_ME_MIN_32_CHAR_RANDOM_STRING
JWT_EXPIRY=900
REFRESH_EXPIRY=604800

# Logging
LOG_LEVEL=info

# Bootstrap (Phase 3 - super admin creation)
BOOTSTRAP_EMAIL=admin@local.com
BOOTSTRAP_PASSWORD=CHANGE_ME
BOOTSTRAP_NAME=Super Admin

# RustFS Object Storage (Payment Proofs)
RUSTFS_ENDPOINT=rustfs:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin123
RUSTFS_BUCKET=social-finance-payment-proofs
RUSTFS_USE_SSL=false

# Firebase Cloud Messaging (FCM HTTP v1)
# Absolute path to the FCM service-account JSON on the backend host.
# Keep this file outside the repository and never commit its contents.
FCM_CREDENTIALS_FILE=/absolute/path/to/fcm-service-account.json
FCM_PROJECT_ID=social-finance-andjoy

# Public Base URL used by backend (FCMProvider) to convert relative notification
# image paths (/api/v1/notifications/images/...) into absolute URLs in FCM payloads.
# (Backend reads PUBLIC_BASE_URL first, with API_PUBLIC_URL as an optional fallback.)
#
# Local development example (replace 192.168.0.41 with the LAN IP of the host
# computer running the backend):
# - Android emulator or physical device can only reach this URL if connected to
#   the same network, the backend port is bound to the host interface (0.0.0.0:8080),
#   and the host firewall allows incoming connections on port 8080.
# - Private LAN IPs (192.168.x.x / 10.x.x.x) CANNOT be reached directly by
#   Firebase/FCM servers from the public internet.
# - Production environments MUST use a publicly reachable HTTPS URL
#   (e.g., PUBLIC_BASE_URL=https://api.urena0216.id).
PUBLIC_BASE_URL=http://192.168.0.41:8080

# Tenant scoping
#
# SCOPED_RT_IDS — **mandatory**. Comma-separated list of RT UUIDs allowed
# for operational access. Backend refuses to start if empty or blank.
# Required for all deployments (RT-only or RW-enabled).
#
#   Example: SCOPED_RT_IDS=a95c1cb5-2f67-4ea5-9197-bfec537b6d7b
#
# SCOPED_RW_IDS — **optional**. Comma-separated list of RW UUIDs that
# Super Admin is allowed to access. If empty or unset, the backend
# starts normally but all RW endpoints remain closed (fail-closed).
# Leave empty for RT-only deployments.
#
#   RT-only deployment: SCOPED_RW_IDS=
#   RW-enabled deployment: SCOPED_RW_IDS=aaaa1111-bbbb-cccc-dddd-eeee22222222
SCOPED_RW_IDS=

# SCOPED_RT_IDS=a95c1cb5-2f67-4ea5-9197-bfec537b6d7b,8dfa1e36-6727-45be-8fea-24d958efc155
SCOPED_RT_IDS=
